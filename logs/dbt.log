    i.draft_round,
    i.draft_pick_number,

    p.is_active,

    case
        when i.greatest_75_flag = 'Y'
        then true
        else false
    end as is_nba_75_player,

    datediff(
        year,
        i.birth_date,
        current_date
    ) as player_age,

    current_date is not null
        as player_exists

from player p
left join info i
    on p.player_id = i.player_id
  );
