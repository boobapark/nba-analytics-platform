create or replace   view BASKETBALL_DEV.staging.stg_common_player_info
  
   as (
    with source as (
    select * from NBA_ANALYTICS.RAW.common_player_info
),
typed as (
    select
        nullif(trim(cast(person_id as varchar)), '') as player_id,
        nullif(trim(cast(first_name as varchar)), '') as first_name,
        nullif(trim(cast(last_name as varchar)), '') as last_name,
        nullif(trim(cast(display_first_last as varchar)), '') as display_name,
        nullif(trim(cast(player_slug as varchar)), '') as player_slug,
        try_cast(nullif(trim(cast(birthdate as varchar)), '') as date) as birth_date,
        nullif(trim(cast(school as varchar)), '') as school,
        nullif(trim(cast(country as varchar)), '') as country,
        nullif(trim(cast(height as varchar)), '') as height,
        try_cast(nullif(trim(cast(weight as varchar)), '') as double) as weight_lbs,
        try_cast(nullif(trim(cast(season_exp as varchar)), '') as bigint) as seasons_experience,
        nullif(trim(cast(jersey as varchar)), '') as jersey_number,
        nullif(trim(cast(position as varchar)), '') as position,
        try_cast(nullif(trim(cast(team_id as varchar)), '') as bigint) as current_team_id,
        try_cast(nullif(trim(cast(from_year as varchar)), '') as bigint) as career_start_year,
        try_cast(nullif(trim(cast(to_year as varchar)), '') as bigint) as career_end_year,
        try_cast(nullif(trim(cast(draft_year as varchar)), '') as bigint) as draft_year,
        try_cast(nullif(trim(cast(draft_round as varchar)), '') as bigint) as draft_round,
        try_cast(nullif(trim(cast(draft_number as varchar)), '') as bigint) as draft_pick_number,
        case
    when lower(nullif(trim(cast(greatest_75_flag as varchar)), '')) in ('true', '1', 'yes', 'y') then true
    when lower(nullif(trim(cast(greatest_75_flag as varchar)), '')) in ('false', '0', 'no', 'n') then false
    else null
end as is_nba_75_player
    from source
)
select distinct * from typed
where player_id is not null
  );
[0m08:48:00.755364 [debug] [Thread-8 (]: Using snowflake connection "model.nba_analytics_platform.stg_inactive_players"
[0m08:48:00.756299 [debug] [Thread-3 (]: On model.nba_analytics_platform.stg_draft_combine_stats: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "nba_analytics", "target_name": "dev", "node_id": "model.nba_analytics_platform.stg_draft_combine_stats"} */
create or replace   view BASKETBALL_DEV.staging.stg_draft_combine_stats
  
   as (
    with source as (
    select * from NBA_ANALYTICS.RAW.draft_combine_stats
)
select distinct
    nullif(trim(cast(player_id as varchar)), '') as player_id,
    try_cast(nullif(trim(cast(season as varchar)), '') as bigint) as draft_year,
    nullif(trim(cast(player_name as varchar)), '') as player_name,
    nullif(trim(cast(position as varchar)), '') as position,
    try_cast(nullif(trim(cast(height_wo_shoes as varchar)), '') as double) as height_no_shoes_inches,
    try_cast(nullif(trim(cast(height_w_shoes as varchar)), '') as double) as height_with_shoes_inches,
    try_cast(nullif(trim(cast(weight as varchar)), '') as double) as weight_lbs,
    try_cast(nullif(trim(cast(wingspan as varchar)), '') as double) as wingspan_inches,
    try_cast(nullif(trim(cast(standing_reach as varchar)), '') as double) as standing_reach_inches,
    try_cast(nullif(trim(cast(body_fat_pct as varchar)), '') as double) as body_fat_pct,
    try_cast(nullif(trim(cast(hand_length as varchar)), '') as double) as hand_length_inches,
    try_cast(nullif(trim(cast(hand_width as varchar)), '') as double) as hand_width_inches,
    try_cast(nullif(trim(cast(standing_vertical_leap as varchar)), '') as double) as standing_vertical_leap_inches,
    try_cast(nullif(trim(cast(max_vertical_leap as varchar)), '') as double) as max_vertical_leap_inches,
    try_cast(nullif(trim(cast(lane_agility_time as varchar)), '') as double) as lane_agility_seconds,
    try_cast(nullif(trim(cast(modified_lane_agility_time as varchar)), '') as double) as modified_lane_agility_seconds,
    try_cast(nullif(trim(cast(three_quarter_sprint as varchar)), '') as double) as sprint_seconds,
    try_cast(nullif(trim(cast(bench_press as varchar)), '') as double) as bench_press_repetitions
from source
